{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Unified user profile containing both account info and health metrics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "age": { "type": "number" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "goal": { "type": "string", "enum": ["weight_loss", "maintenance", "muscle_gain"] },
        "activityLevel": { "type": "string", "enum": ["sedentary", "light", "moderate", "active"] },
        "lastLogin": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "subscriptionStatus": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "MealLog": {
      "title": "Meal Log",
      "description": "Log of consumed food.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "foodName": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "fiber": { "type": "number" },
        "sugar": { "type": "number" },
        "sodium": { "type": "number" },
        "mealType": { "type": "string" },
        "servingSize": { "type": "string" },
        "quantity": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "manual": { "type": "boolean" },
        "aiGenerated": { "type": "boolean" },
        "cuisine": { "type": "string" }
      },
      "required": ["userId", "foodName", "calories", "timestamp"]
    },
    "WaterLog": {
      "title": "Water Log",
      "description": "Log of water intake.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amountMl": { "type": "number" },
        "loggedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amountMl", "loggedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "mealLogs/{logId}": {
      "schema": "MealLog",
      "description": "Meal logs for all users."
    },
    "waterLogs/{logId}": {
      "schema": "WaterLog",
      "description": "Water logs for all users."
    }
  }
}
